@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["LoginTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-4 card p-4 shadow-sm">
        <h2 class="text-center">@Localizer["LoginTitle"]</h2>
        <form asp-action="Login" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">@Localizer["Username"]</label>
                <input type="text" name="username" class="form-control" placeholder="@Localizer["UsernamePlaceholder"]" required />
            </div>
            <div class="mb-3">
                <label class="form-label">@Localizer["SelectRole"]</label>
                <select name="role" class="form-select">
                    <option value="User">@Localizer["RegularUser"]</option>
                    <option value="Admin">@Localizer["Administrator"]</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["SubmitButton"]</button>
        </form>
    </div>
</div>
