@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["MetaTitle"];
}

<!-- Hero Section - Modern 2 Columns -->
<section class="py-5 my-3 position-relative">
    <div class="container py-lg-4">
        <div class="row align-items-center g-5">
            <!-- Columna Texto y CTA -->
            <div class="col-lg-7 text-center text-lg-start">
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-3 fs-6">
                    <i class="bi bi-stars me-1"></i> Software &amp; AI Agents
                </span>
                <h1 class="display-4 fw-extrabold text-dark tracking-tight mb-3">
                    @Localizer["HeroTitle"]
                </h1>
                <p class="lead text-secondary fs-5 mb-4 pe-lg-4">
                    @Localizer["HeroSubtitle"]
                </p>
                <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                    <a href="#services" class="btn btn-primary btn-lg px-4 py-3 shadow-sm rounded-pill fw-semibold">
                        <i class="bi bi-lightning-charge-fill me-1"></i> @Localizer["HeroCTA"]
                    </a>
                    <a href="mailto:contacto@gamvardv.com" class="btn btn-outline-dark btn-lg px-4 py-3 rounded-pill fw-semibold">
                        @Localizer["CTAButton"]
                    </a>
                </div>
            </div>
            
            <!-- Columna Logo Visual -->
            <div class="col-lg-5 text-center">
                <div class="hero-logo-wrapper p-3">
                    <img src="~/images/logo.svg" alt="Grupo GA&amp;V" class="img-fluid hero-logo" style="max-height: 280px; filter: drop-shadow(0 15px 30px rgba(30, 58, 95, 0.15));" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Barra de Pilares de Valor (Motto de la Empresa) -->
<section class="py-4 my-4 bg-light rounded-4 border">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                        <i class="bi bi-award fs-3"></i>
                    </div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0 text-dark">Excelencia</h6>
                        <small class="text-muted">Calidad en cada línea de código</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                        <i class="bi bi-shield-check fs-3"></i>
                    </div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0 text-dark">Profesionalismo</h6>
                        <small class="text-muted">Metodologías ágiles y robustas</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center justify-content-center gap-3">
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0 text-dark">Puntualidad</h6>
                        <small class="text-muted">Entregas a tiempo y a medida</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección de Servicios -->
<section id="services" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-primary fw-bold text-uppercase tracking-wider">Servicios</h6>
            <h2 class="display-6 fw-bold text-dark">@Localizer["ServicesTitle"]</h2>
        </div>
        
        <div class="row g-4 justify-content-center">
            <!-- Servicio 1: Software a la medida -->
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 border rounded-4 shadow-sm p-4 p-lg-5 hover-card transition bg-white">
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-3 d-inline-flex align-items-center justify-content-center mb-4" style="width: 60px; height: 60px;">
                        <i class="bi bi-code-slash fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">@Localizer["Service1Title"]</h4>
                    <p class="text-secondary mb-4 leading-relaxed">@Localizer["Service1Desc"]</p>
                    <ul class="list-unstyled text-secondary small mb-0 mt-auto">
                        <li class="mb-2"><i class="bi bi-check2-circle text-primary me-2"></i>Arquitectura Escalable (.NET / Cloud)</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-primary me-2"></i>Plataformas Web y Móviles</li>
                        <li><i class="bi bi-check2-circle text-primary me-2"></i>Integración de APIs y Sistemas</li>
                    </ul>
                </div>
            </div>

            <!-- Servicio 2: Agentes de IA -->
            <div class="col-md-6 col-lg-5">
                <div class="card h-100 border rounded-4 shadow-sm p-4 p-lg-5 hover-card transition bg-white">
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-3 d-inline-flex align-items-center justify-content-center mb-4" style="width: 60px; height: 60px;">
                        <i class="bi bi-robot fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">@Localizer["Service2Title"]</h4>
                    <p class="text-secondary mb-4 leading-relaxed">@Localizer["Service2Desc"]</p>
                    <ul class="list-unstyled text-secondary small mb-0 mt-auto">
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Agentes Autónomos para Tareas Repetitivas</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Automatización de Procesos Empresariales</li>
                        <li><i class="bi bi-check2-circle text-success me-2"></i>Análisis Inteligente y LLMs</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sección de Cierre / Contacto -->
<section class="py-5 my-5">
    <div class="container">
        <div class="p-5 rounded-4 text-center position-relative overflow-hidden shadow-sm border bg-white" style="background: linear-gradient(180deg, #ffffff 0%, #f8f9fc 100%);">
            <h2 class="display-6 fw-bold text-dark mb-3">@Localizer["CTASectionTitle"]</h2>
            <p class="text-secondary fs-5 col-md-8 mx-auto mb-4">@Localizer["CTASectionDesc"]</p>
            <a href="mailto:contacto@gamvardv.com" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-sm fw-semibold">
                <i class="bi bi-envelope-fill me-2"></i> @Localizer["CTAButton"]
            </a>
        </div>
    </div>
</section>

<style>
    .fw-extrabold { font-weight: 800; }
    .tracking-tight { letter-spacing: -0.02em; }
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    .hover-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1.25rem 2.5rem rgba(30, 58, 95, 0.08) !important;
        border-color: #0d6efd !important;
    }
    .hero-logo {
        transition: transform 0.4s ease;
    }
    .hero-logo:hover {
        transform: scale(1.04);
    }
</style>
